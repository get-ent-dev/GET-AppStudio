<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing backdrop halo -->
    <path
        android:pathData="M54,26 C69,26 82,39 82,54 C82,69 69,82 54,82 C39,82 26,69 26,54 C26,39 39,26 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:gradientRadius="30"
                android:centerX="54"
                android:centerY="54"
                android:type="radial">
                <item android:color="#4000E5FF" android:offset="0.0" />
                <item android:color="#207C3AED" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Studio Phone / Shield Frame -->
    <path
        android:pathData="M38,24 L70,24 C74.4,24 78,27.6 78,32 L78,76 C78,80.4 74.4,84 70,84 L38,84 C33.6,84 30,80.4 30,76 L30,32 C30,27.6 33.6,24 38,24 Z"
        android:strokeWidth="3.2"
        android:strokeColor="#1E3A8A">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="24"
                android:endX="78"
                android:endY="84"
                android:type="linear">
                <item android:color="#1E1B4B" android:offset="0.0" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Android Head / Studio Dome inside -->
    <path
        android:pathData="M37,46 C37,36.6 44.6,29 54,29 C63.4,29 71,36.6 71,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="29"
                android:endX="71"
                android:endY="46"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Antennae -->
    <path
        android:pathData="M43,30 L38,23 M65,30 L70,23"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />

    <!-- Robot Eyes -->
    <path
        android:pathData="M44,40 A2,2 0 1,1 44,40.01 M64,40 A2,2 0 1,1 64,40.01"
        android:fillColor="#FFFFFF" />

    <!-- Dynamic Lightning Bolt Symbol (GET AppStudio Power) -->
    <path
        android:pathData="M56,36 L44,55 L52,55 L47,75 L65,51 L56,51 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="36"
                android:endX="65"
                android:endY="75"
                android:type="linear">
                <item android:color="#FFD600" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.5" />
                <item android:color="#A855F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Indicator Pill / Home Bar -->
    <path
        android:pathData="M48,79 L60,79"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#38BDF8" />

</vector>
